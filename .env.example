# Copy to .env and set strong, unique passwords before initializing the database.
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
LAB_JOSHUA_PASSWORD=change-this-joshua-password
LAB_SABARI_PASSWORD=change-this-sabari-password
LAB_NITHIN_PASSWORD=change-this-nithin-password
LAB_ADMIN_PASSWORD=change-this-admin-password
EDUSERVE_LAB_MODE=vulnerable
